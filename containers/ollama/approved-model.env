# The only model this curated image is allowed to serve.
# Changing it requires rebuilding the image, which produces a new image digest.
APPROVED_MODEL='tinyllama:1.1b'
APPROVED_MODEL_MANIFEST='manifests/registry.ollama.ai/library/tinyllama/1.1b'

# The exact entries of the model's manifest, taken from
# registry.ollama.ai/v2/library/tinyllama/manifests/1.1b, in manifest order.
# One entry per line: role (config or layer), media type, digest, size.
#
# The installed manifest is decoded as JSON and must contain exactly these
# entries: same order, same media type (which decides each layer's role:
# weights, template, system prompt or parameters), same digest and same size.
# Every referenced file is then hashed. This stops an edited manifest from
# adding a layer or reusing an approved file in a different role.
